<!DOCTYPE html>
<html lang="da">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dansk Vibe Learning 2.0</title>
  <style>
    :root {
      --ink: #18202a;
      --muted: #657080;
      --line: #d9dee7;
      --paper: #fbfbf8;
      --panel: #ffffff;
      --blue: #2563eb;
      --teal: #0f766e;
      --red: #c2410c;
      --green: #15803d;
      --gold: #b45309;
      --shadow: 0 18px 55px rgba(24, 32, 42, 0.14);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at top left, rgba(37, 99, 235, 0.15), transparent 34rem),
        linear-gradient(135deg, #f7f4ec 0%, #eef6f4 42%, #f7f8fb 100%);
    }

    main {
      width: min(1180px, calc(100vw - 32px));
      margin: 0 auto;
      padding: 28px 0;
    }

    header {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 18px;
      align-items: end;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(24, 32, 42, 0.12);
    }

    h1 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 4.5rem);
      line-height: 0.95;
      letter-spacing: 0;
    }

    .subtitle {
      margin: 10px 0 0;
      max-width: 680px;
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.55;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(88px, 1fr));
      gap: 8px;
      min-width: min(390px, 100%);
    }

    .stat {
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(24, 32, 42, 0.11);
      border-radius: 8px;
      padding: 12px;
      backdrop-filter: blur(10px);
    }

    .stat strong {
      display: block;
      font-size: 1.4rem;
      line-height: 1;
    }

    .stat span {
      display: block;
      margin-top: 5px;
      color: var(--muted);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .workspace {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 22px;
      margin-top: 24px;
      align-items: start;
    }

    .flashcard {
      overflow: hidden;
      background: var(--panel);
      border: 1px solid rgba(24, 32, 42, 0.12);
      border-radius: 8px;
      box-shadow: var(--shadow);
    }

    .image-wrap {
      position: relative;
      aspect-ratio: 16 / 9;
      background: #e8edf0;
      overflow: hidden;
    }

    .image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .badge {
      position: absolute;
      top: 14px;
      left: 14px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(24, 32, 42, 0.12);
      border-radius: 999px;
      padding: 8px 11px;
      font-size: 0.82rem;
      font-weight: 700;
    }

    .card-body {
      display: grid;
      gap: 18px;
      padding: clamp(18px, 4vw, 34px);
    }

    .word-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
    }

    .word {
      position: relative;
      width: fit-content;
      margin: 0;
      font-size: clamp(2.6rem, 8vw, 7rem);
      line-height: 0.9;
      letter-spacing: 0;
      cursor: help;
    }

    .word::after {
      content: attr(data-meaning);
      position: absolute;
      left: 0;
      bottom: calc(100% + 10px);
      width: max-content;
      max-width: min(360px, 82vw);
      padding: 9px 12px;
      border-radius: 8px;
      background: #18202a;
      color: white;
      font-size: 1rem;
      line-height: 1.25;
      opacity: 0;
      transform: translateY(8px);
      pointer-events: none;
      transition: opacity 150ms ease, transform 150ms ease;
      box-shadow: 0 10px 30px rgba(24, 32, 42, 0.2);
      z-index: 2;
    }

    .word:hover::after,
    .word:focus-visible::after {
      opacity: 1;
      transform: translateY(0);
    }

    .icon-button {
      display: inline-grid;
      place-items: center;
      flex: 0 0 auto;
      width: 46px;
      height: 46px;
      border: 1px solid rgba(24, 32, 42, 0.14);
      border-radius: 8px;
      background: #f8fafc;
      color: var(--ink);
      cursor: pointer;
      transition: transform 120ms ease, background 120ms ease;
    }

    .icon-button:hover { transform: translateY(-1px); background: #eef2f7; }

    .meaning {
      min-height: 56px;
      padding: 14px 16px;
      border: 1px dashed var(--line);
      border-radius: 8px;
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.45;
    }

    .meaning.revealed {
      border-style: solid;
      color: var(--ink);
      background: #f8fafc;
      font-weight: 700;
    }

    .actions {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }

    button {
      min-height: 46px;
      border: 0;
      border-radius: 8px;
      padding: 11px 14px;
      font: inherit;
      font-weight: 750;
      cursor: pointer;
    }

    .primary { background: var(--blue); color: white; }
    .again { background: #fee2e2; color: #991b1b; }
    .hard { background: #ffedd5; color: var(--red); }
    .good { background: #dbeafe; color: #1d4ed8; }
    .easy { background: #dcfce7; color: var(--green); }

    .side {
      display: grid;
      gap: 14px;
    }

    .panel {
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(24, 32, 42, 0.12);
      border-radius: 8px;
      padding: 16px;
    }

    .panel h2 {
      margin: 0 0 12px;
      font-size: 1rem;
      letter-spacing: 0;
    }

    .progress-track {
      height: 10px;
      overflow: hidden;
      border-radius: 999px;
      background: #e2e8f0;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--teal), var(--blue));
      transition: width 180ms ease;
    }

    .queue {
      display: grid;
      gap: 8px;
      margin-top: 12px;
    }

    .queue div {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      color: var(--muted);
      font-size: 0.92rem;
    }

    .module-tools {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .ghost {
      background: #f8fafc;
      color: var(--ink);
      border: 1px solid rgba(24, 32, 42, 0.14);
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    @media (max-width: 860px) {
      header,
      .workspace {
        grid-template-columns: 1fr;
      }

      .stats {
        min-width: 0;
      }
    }

    @media (max-width: 560px) {
      main {
        width: min(100vw - 20px, 1180px);
        padding: 16px 0;
      }

      .stats,
      .actions,
      .module-tools {
        grid-template-columns: 1fr;
      }

      .word-row {
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <main>
    <header>
      <div>
        <h1>Dansk Vibe Learning 2.0</h1>
        <p class="subtitle">A 500-word Danish flashcard module with generated picture cues, Danish pronunciation, hover-to-translate answers, and Anki-inspired review timing based on the forgetting curve.</p>
      </div>
      <section class="stats" aria-label="Study stats">
        <div class="stat"><strong id="seenCount">0</strong><span>Seen</span></div>
        <div class="stat"><strong id="dueCount">0</strong><span>Due now</span></div>
        <div class="stat"><strong id="matureCount">0</strong><span>Mature</span></div>
      </section>
    </header>

    <section class="workspace">
      <article class="flashcard" aria-live="polite">
        <div class="image-wrap">
          <img id="vocabImage" alt="" referrerpolicy="no-referrer" />
          <span class="badge" id="cardPosition">Card 1 / 500</span>
        </div>
        <div class="card-body">
          <div class="word-row">
            <h2 class="word" id="danishWord" tabindex="0" data-meaning="">Indlæser</h2>
            <button class="icon-button" id="speakButton" type="button" title="Play Danish pronunciation" aria-label="Play Danish pronunciation">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M11 5 6 9H3v6h3l5 4V5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                <path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          <p class="meaning" id="meaningBox">Hover over the Danish word or press Show Meaning.</p>
          <button class="primary" id="revealButton" type="button">Show Meaning</button>
          <div class="actions" id="ratingButtons" hidden>
            <button class="again" type="button" data-rating="again">Again<br><span id="againTime">1 min</span></button>
            <button class="hard" type="button" data-rating="hard">Hard<br><span id="hardTime">10 min</span></button>
            <button class="good" type="button" data-rating="good">Good<br><span id="goodTime">1 day</span></button>
            <button class="easy" type="button" data-rating="easy">Easy<br><span id="easyTime">4 days</span></button>
          </div>
        </div>
      </article>

      <aside class="side">
        <section class="panel">
          <h2>Module Progress</h2>
          <div class="progress-track" aria-hidden="true"><div class="progress-fill" id="progressFill"></div></div>
          <div class="queue">
            <div><span>Deck size</span><strong id="deckSize">500</strong></div>
            <div><span>New cards left</span><strong id="newCount">500</strong></div>
            <div><span>Reviews waiting</span><strong id="reviewCount">0</strong></div>
          </div>
        </section>

        <section class="panel">
          <h2>Forgetting-Curve Rules</h2>
          <div class="queue">
            <div><span>Again</span><strong>1 min</strong></div>
            <div><span>Hard</span><strong>short step</strong></div>
            <div><span>Good</span><strong>growing interval</strong></div>
            <div><span>Easy</span><strong>ease bonus</strong></div>
          </div>
        </section>

        <section class="panel">
          <h2>Controls</h2>
          <div class="module-tools">
            <button class="ghost" id="shuffleButton" type="button">Shuffle</button>
            <button class="ghost" id="resetButton" type="button">Reset</button>
          </div>
        </section>
      </aside>
    </section>
  </main>

  <script>
    const STORAGE_KEY = "dansk-vibe-learning-2-progress-v2";
    const DAY = 24 * 60 * 60 * 1000;
    const MINUTE = 60 * 1000;

