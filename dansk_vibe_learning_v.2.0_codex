skov|forest|forest
bjerg|mountain|mountain
sø|lake|lake
flod|river|river
hav|sea|sea
ø|island|island
by|city|city
landsby|village|village
kontor|office|office
bank|bank|bank
posthus|post office|post office
kirke|church|church
torv|square|town square
marked|market|market
trappe|stairs|stairs
elevator|elevator|elevator
tag|roof|roof
gulv|floor|floor
væg|wall|wall
loft|ceiling|ceiling
have|garden|garden
garage|garage|garage
balkon|balcony|balcony
kælder|basement|basement
salt|salt|salt
peber|pepper|pepper
sukker|sugar|sugar
mel|flour|flour
olie|oil|oil
honning|honey|honey
chokolade|chocolate|chocolate
citron|lemon|lemon
pære|pear|pear
vindrue|grape|grapes
gulerod|carrot|carrot
champignon|mushroom|mushroom
blomst|flower|flower
træ|tree|tree
græs|grass|grass
blad|leaf|leaf
sten|stone|stone
sand|sand|sand
ild|fire|fire
røg|smoke|smoke
stjerne|star|star
måne|moon|moon
regnbue|rainbow|rainbow
jakke|jacket|jacket
skjorte|shirt|shirt
bukser|pants|pants
kjole|dress|dress
sko|shoes|shoes
sokker|socks|socks
hat|hat|hat
handsker|gloves|gloves
tørklæde|scarf|scarf
ur|watch|watch
briller|glasses|glasses
paraply|umbrella|umbrella
sæbe|soap|soap
shampoo|shampoo|shampoo
håndklæde|towel|towel
tandbørste|toothbrush|toothbrush
tandpasta|toothpaste|toothpaste
spejl|mirror|mirror
kam|comb|comb
vaskemaskine|washing machine|washing machine
køleskab|refrigerator|refrigerator
ovn|oven|oven
komfur|stove|stove
`;

    const numbersDa = [
      "nul","en","to","tre","fire","fem","seks","syv","otte","ni","ti","elleve","tolv","tretten","fjorten","femten","seksten","sytten","atten","nitten",
      "tyve","enogtyve","toogtyve","treogtyve","fireogtyve","femogtyve","seksogtyve","syvogtyve","otteogtyve","niogtyve",
      "tredive","enogtredive","toogtredive","treogtredive","fireogtredive","femogtredive","seksogtredive","syvogtredive","otteogtredive","niogtredive",
      "fyrre","enogfyrre","toogfyrre","treogfyrre","fireogfyrre","femogfyrre","seksogfyrre","syvogfyrre","otteogfyrre","niogfyrre",
      "halvtreds","enoghalvtreds","tooghalvtreds","treoghalvtreds","fireoghalvtreds","femoghalvtreds","seksoghalvtreds","syvoghalvtreds","otteoghalvtreds","nioghalvtreds",
      "tres","enogtres","toogtres","treogtres","fireogtres","femogtres","seksogtres","syvogtres","otteogtres","niogtres",
      "halvfjerds","enoghalvfjerds","tooghalvfjerds","treoghalvfjerds","fireoghalvfjerds","femoghalvfjerds","seksoghalvfjerds","syvoghalvfjerds","otteoghalvfjerds","nioghalvfjerds",
      "firs","enogfirs","toogfirs","treogfirs","fireogfirs","femogfirs","seksogfirs","syvogfirs","otteogfirs","niogfirs",
      "halvfems","enoghalvfems","tooghalvfems","treoghalvfems","fireoghalvfems","femoghalvfems","seksoghalvfems","syvoghalvfems","otteoghalvfems","nioghalvfems","hundrede"
    ];

    const ordinalPairs = `
første|first|number first
anden|second|number second
tredje|third|number third
fjerde|fourth|number fourth
femte|fifth|number fifth
sjette|sixth|number sixth
syvende|seventh|number seventh
ottende|eighth|number eighth
niende|ninth|number ninth
tiende|tenth|number tenth
ellevte|eleventh|number eleven
tolvte|twelfth|number twelve
trettende|thirteenth|number thirteen
fjortende|fourteenth|number fourteen
femtende|fifteenth|number fifteen
sekstende|sixteenth|number sixteen
syttende|seventeenth|number seventeen
attende|eighteenth|number eighteen
nittende|nineteenth|number nineteen
tyvende|twentieth|number twenty
`;

    function parsePairs(text) {
      return text.trim().split(/\n+/).map((line) => {
        const [word, translation, image = translation] = line.split("|");
        return { word, translation, image };
      });
    }

    const numberCards = numbersDa.map((word, number) => ({
      word,
      translation: number === 100 ? "one hundred" : String(number),
      image: `number ${number}`
    }));

    const rawDeck = [
      ...parsePairs(corePairs),
      ...parsePairs(extraPairs),
      ...parsePairs(countryPairs),
      ...parsePairs(professionPairs),
      ...numberCards,
      ...parsePairs(ordinalPairs)
    ];

    const baseDeck = rawDeck
      .filter((card, index, array) => array.findIndex((other) => other.word.toLowerCase() === card.word.toLowerCase()) === index)
      .slice(0, 500)
      .map((card, index) => ({ id: index + 1, ...card }));

    let progress = loadProgress();
    let currentCard = null;
    let answerShown = false;

    const el = {
      image: document.getElementById("vocabImage"),
      word: document.getElementById("danishWord"),
      meaning: document.getElementById("meaningBox"),
      reveal: document.getElementById("revealButton"),
      ratings: document.getElementById("ratingButtons"),
      speak: document.getElementById("speakButton"),
      position: document.getElementById("cardPosition"),
      seen: document.getElementById("seenCount"),
      due: document.getElementById("dueCount"),
      mature: document.getElementById("matureCount"),
      deckSize: document.getElementById("deckSize"),
      newCount: document.getElementById("newCount"),
      reviewCount: document.getElementById("reviewCount"),
      progress: document.getElementById("progressFill"),
      againTime: document.getElementById("againTime"),
      hardTime: document.getElementById("hardTime"),
      goodTime: document.getElementById("goodTime"),
      easyTime: document.getElementById("easyTime")
    };

    function loadProgress() {
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
        return saved && typeof saved === "object" ? saved : {};
      } catch {
        return {};
      }
    }

    function saveProgress() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
    }

    function stateFor(card) {
      if (!progress[card.id]) {
        progress[card.id] = {
          seen: false,
          repetitions: 0,
          intervalDays: 0,
          ease: 2.5,
          due: 0,
          lapses: 0
        };
      }
      return progress[card.id];
    }

    function dueCards(now = Date.now()) {
      return baseDeck.filter((card) => stateFor(card).seen && stateFor(card).due <= now);
    }

    function newCards() {
      return baseDeck.filter((card) => !stateFor(card).seen);
    }

    function pickNextCard() {
      const now = Date.now();
      const due = dueCards(now).sort((a, b) => stateFor(a).due - stateFor(b).due);
      if (due.length) return due[0];
      const fresh = newCards();
      if (fresh.length) return fresh[0];
      return baseDeck
        .slice()
        .sort((a, b) => stateFor(a).due - stateFor(b).due)[0];
    }

    function imageUrl(card) {
      const query = `${card.image || card.translation} ${card.word}`.toLowerCase();
      const iconRules = [
        ["coffee tea cup drink glass milk water beer wine", "☕"], ["food breakfast lunch dinner bread cake pasta rice soup", "🍽️"],
        ["apple banana orange strawberry tomato cucumber onion potato carrot grape pear lemon", "🍎"], ["house apartment room kitchen bathroom bedroom home", "🏠"],
        ["car bus train bicycle taxi airplane boat road street station airport travel", "🚆"], ["book paper pen school university class homework teacher student language", "📚"],
        ["phone computer programmer office work plan idea problem solution", "💻"], ["money price receipt shop supermarket market bank", "💳"],
        ["doctor hospital medicine pharmacy healthy sick dentist nurse", "⚕️"], ["sun rain snow wind cloud weather moon star rainbow", "☀️"],
        ["dog cat bird horse cow pig sheep mouse animal", "🐾"], ["music song movie television game sport soccer swimming running", "🎵"],
        ["family mother father sister brother child parent friend person man woman boy girl", "👥"], ["body head hair eye ear nose mouth tooth hand arm leg foot heart", "🧍"],
        ["library museum theater cinema park beach forest mountain lake river sea island city village", "🏞️"],
        ["jacket shirt pants dress shoes socks hat gloves scarf glasses umbrella", "🧥"], ["denmark sweden norway finland iceland germany france spain italy", "🗺️"],
        ["red blue green yellow black white gray brown purple pink orange color", "🎨"], ["number first second third fourth fifth", "#"], ["clock calendar time day week month year morning evening", "🕒"]
      ];
      const match = iconRules.find(([words]) => words.split(" ").some((word) => query.includes(word)));
      const icon = match ? match[1] : "✦";
      const hue = Math.abs([...query].reduce((sum, char) => sum + char.charCodeAt(0), 0)) % 360;
      const svg = `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" role="img" aria-label="Generated picture cue">
          <defs>
            <linearGradient id="bg" x1="0" x2="1" y1="0" y2="1">
              <stop offset="0%" stop-color="hsl(${hue}, 64%, 88%)"/>
              <stop offset="54%" stop-color="hsl(${(hue + 42) % 360}, 58%, 80%)"/>
              <stop offset="100%" stop-color="hsl(${(hue + 130) % 360}, 42%, 92%)"/>
            </linearGradient>
            <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow dx="0" dy="18" stdDeviation="18" flood-color="#18202a" flood-opacity="0.2"/>
            </filter>
          </defs>
          <rect width="1200" height="675" fill="url(#bg)"/>
          <circle cx="940" cy="120" r="210" fill="rgba(255,255,255,0.34)"/>
          <circle cx="184" cy="560" r="240" fill="rgba(255,255,255,0.28)"/>
          <rect x="235" y="115" width="730" height="445" rx="34" fill="rgba(255,255,255,0.72)" filter="url(#shadow)"/>
          <text x="600" y="370" text-anchor="middle" font-size="190" font-family="Apple Color Emoji, Segoe UI Emoji, Noto Color Emoji, sans-serif">${escapeSvg(icon)}</text>
          <text x="600" y="480" text-anchor="middle" font-size="58" font-weight="800" font-family="Inter, Arial, sans-serif" fill="#18202a">${escapeSvg(card.word)}</text>
        </svg>`;
      return `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(svg)}`;
    }

    function escapeSvg(text) {
      return String(text)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function showCard() {
      currentCard = pickNextCard();
      answerShown = false;
      const state = stateFor(currentCard);
      el.word.textContent = currentCard.word;
      el.word.dataset.meaning = currentCard.translation;
      el.meaning.textContent = "Hover over the Danish word or press Show Meaning.";
      el.meaning.classList.remove("revealed");
      el.ratings.hidden = true;
      el.reveal.hidden = false;
      el.image.src = imageUrl(currentCard);
      el.image.alt = `Image cue for ${currentCard.translation}`;
      el.position.textContent = `Card ${currentCard.id} / ${baseDeck.length}`;
      updateTimeLabels(state);
      updateStats();
      window.setTimeout(() => speak(currentCard.word, false), 250);
    }

    function showAnswer() {
      answerShown = true;
      el.meaning.textContent = currentCard.translation;
      el.meaning.classList.add("revealed");
      el.ratings.hidden = false;
      el.reveal.hidden = true;
    }

    function nextIntervals(state) {
      const hard = state.repetitions === 0 ? 10 * MINUTE : Math.max(1, state.intervalDays * 1.2) * DAY;
      const goodDays = state.repetitions === 0 ? 1 : Math.max(1, state.intervalDays * state.ease);
      const easyDays = state.repetitions === 0 ? 4 : Math.max(2, state.intervalDays * (state.ease + 0.35));
      return {
        again: 1 * MINUTE,
        hard,
        good: goodDays * DAY,
        easy: easyDays * DAY
      };
    }

    function rateCard(rating) {
      if (!answerShown) showAnswer();
      const state = stateFor(currentCard);
      const now = Date.now();
      const intervals = nextIntervals(state);
      state.seen = true;

      if (rating === "again") {
        state.repetitions = 0;
        state.intervalDays = 0;
        state.ease = Math.max(1.3, state.ease - 0.2);
        state.lapses += 1;
        state.due = now + intervals.again;
      }

      if (rating === "hard") {
        state.repetitions = Math.max(1, state.repetitions);
        state.intervalDays = intervals.hard / DAY;
        state.ease = Math.max(1.3, state.ease - 0.15);
        state.due = now + intervals.hard;
      }

      if (rating === "good") {
        state.repetitions += 1;
        state.intervalDays = intervals.good / DAY;
        state.due = now + intervals.good;
      }

      if (rating === "easy") {
        state.repetitions += 1;
        state.intervalDays = intervals.easy / DAY;
        state.ease = Math.min(3.2, state.ease + 0.15);
        state.due = now + intervals.easy;
      }

      saveProgress();
      showCard();
    }

    function updateTimeLabels(state) {
      const intervals = nextIntervals(state);
      el.againTime.textContent = formatInterval(intervals.again);
      el.hardTime.textContent = formatInterval(intervals.hard);
      el.goodTime.textContent = formatInterval(intervals.good);
      el.easyTime.textContent = formatInterval(intervals.easy);
    }

    function formatInterval(ms) {
      if (ms < DAY) return `${Math.max(1, Math.round(ms / MINUTE))} min`;
      const days = Math.round(ms / DAY);
      return days === 1 ? "1 day" : `${days} days`;
    }

    function updateStats() {
      const states = baseDeck.map(stateFor);
      const seen = states.filter((state) => state.seen).length;
      const due = dueCards().length;
      const mature = states.filter((state) => state.intervalDays >= 21).length;
      const reviews = states.filter((state) => state.seen && state.due <= Date.now()).length;
      el.seen.textContent = seen;
      el.due.textContent = due;
      el.mature.textContent = mature;
      el.deckSize.textContent = baseDeck.length;
      el.newCount.textContent = baseDeck.length - seen;
      el.reviewCount.textContent = reviews;
      el.progress.style.width = `${Math.round((seen / baseDeck.length) * 100)}%`;
    }

    function speak(text, force = true) {
      if (!("speechSynthesis" in window)) return;
      if (!force && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const utterance = new SpeechSynthesisUtterance(text.replace(/^at /, ""));
      utterance.lang = "da-DK";
      utterance.rate = 0.82;
      utterance.pitch = 1;
      const voices = speechSynthesis.getVoices();
      const danishVoice = voices.find((voice) => voice.lang.toLowerCase().startsWith("da"));
      if (danishVoice) utterance.voice = danishVoice;
      speechSynthesis.cancel();
      speechSynthesis.speak(utterance);
    }

    function shuffleUnseen() {
      const unseen = newCards();
      unseen.forEach((card) => {
        const swapWith = unseen[Math.floor(Math.random() * unseen.length)];
        const a = baseDeck.indexOf(card);
        const b = baseDeck.indexOf(swapWith);
        [baseDeck[a], baseDeck[b]] = [baseDeck[b], baseDeck[a]];
      });
      showCard();
    }

    function resetProgress() {
      if (!confirm("Reset all Dansk Vibe Learning progress on this browser?")) return;
      progress = {};
      localStorage.removeItem(STORAGE_KEY);
      showCard();
    }

    el.reveal.addEventListener("click", showAnswer);
    el.speak.addEventListener("click", () => speak(currentCard.word));
    el.ratings.addEventListener("click", (event) => {
      const button = event.target.closest("button[data-rating]");
      if (button) rateCard(button.dataset.rating);
    });
    document.getElementById("shuffleButton").addEventListener("click", shuffleUnseen);
    document.getElementById("resetButton").addEventListener("click", resetProgress);
    document.addEventListener("keydown", (event) => {
      if (event.key === " ") {
        event.preventDefault();
        showAnswer();
      }
      if (["1", "2", "3", "4"].includes(event.key) && answerShown) {
        rateCard(["again", "hard", "good", "easy"][Number(event.key) - 1]);
      }
    });
    window.speechSynthesis?.addEventListener?.("voiceschanged", () => updateStats());

    showCard();
  </script>
</body>
</html>
